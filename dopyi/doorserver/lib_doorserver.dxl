string modGetInfo(Module m, string s_divisor){
	/* This function return information about the module (s_divisor=#):
    	KEY:prefix # CUST_REQ_ # KEY:last_modified_on # 11/09/22 #
	*/
	string s_ret = ""
	s_ret = "KEY:prefix" s_divisor
	s_ret = s_ret m."prefix" s_divisor
	s_ret = s_ret "KEY:last_modified_on" s_divisor
	Date d = m."Last Modified On"
	s_ret = s_ret stringOf(d, "dd/MM/yy") s_divisor
	string mod_url = getURL(m)
	s_ret = s_ret "KEY:module_url" s_divisor mod_url s_divisor
	return s_ret
}

string modGetAttributeList(Module m, int from, string s_divisor){
	string objAttrName
	string msg = ""
	AttrDef ad
	//string objAttrName
	int len = 0
	int i = 0
	for ad in m do {
		if ( ad.object == true ){
			if ( i >= from ){
				msg = msg ad.name s_divisor
				len = length(msg)
				if ( len > 1800 ){
					msg = msg "KEY:more" s_divisor
					break
				}
			}
			i = i + 1
		}
	}
	return msg
}


string modGetAttributeColValues(Module m, string s_attr_name, string s_divisor){
	string msg = ""
	Object o
	for o in m do {
		msg = msg o.s_attr_name " " s_divisor
	}
	return msg 
}

string modGetModifiedObject(Module m, string s_last_load_data, string s_divisor){
	/* This function return the list of absno of object which was changed
	after the s_last_load_data.
	*/
	string msg = ""
	Date d_last_load = date(s_last_load_data, "dd/MM/yy")
	Date d_o
	Object o
	for o in m do {
		d_o = o."Last Modified On"
		if ( d_o >= d_last_load )
			msg = msg o."Absolute Number" s_divisor
	}
	return msg 
}

// this function count the element of a string
int count(Skip skip){

    if(null skip)
        return 0

    int i = 0

    // Doesn't get assigned unless you do something like obj = obj within the loop
    string obj = null 

    for obj in skip do
    {
        i++
    }

    return i
}

//---------------------------------------------------------------------------------------------------------------------------------------------------------------
// Function on module m
//---------------------------------------------------------------------------------------------------------------------------------------------------------------

string objGetInOutLink(Module m, int absno, string s_divisor){
	/* This function return the list of in and out link in the following format:

	*/
	// Object to analyse
	Object o = object(absno, m)
	if ( o == null ){
		return "Error:#1:Absolute number not found"
	}
	// Support variable
	Link lnk
	LinkRef lnkRef
	ExternalLink extlnk
	Module m_sup
	int i
	ModName_ srcModRef
	string s = ""

	// Incoming link
	for lnkRef in all (o<-"*") do {
		s = s "KEY:in" s_divisor
		// Link module
		m_sup = module lnkRef
		s = s fullName(m_sup) s_divisor
		// Souce module
		s = s get_source(lnkRef) s_divisor
		// Source Absno
		i = sourceAbsNo(lnkRef)
		s = s i s_divisor
	}
	// Outgoing link
	for lnk in all (o->"*") do {
		s = s "KEY:out" s_divisor
		// Link module
		m_sup = module lnk
		s = s fullName(m_sup) s_divisor
		// Dest module
		s = s get_target(lnk) s_divisor
		// Dest Absno
		i = targetAbsNo(lnk)
		s = s i s_divisor
	}
	// External link
	for extlnk in o->"" do {
		s = s "KEY:ext" s_divisor
		// Link name
		s = s name(extlnk) s_divisor
		// link description
		s = s description(extlnk) s_divisor
		// link url
		s = s body(extlnk) s_divisor
	}

	return s
}


string objGetAttrDef(Module m, string s_attr, string s_divisor){
	/* Return the data of the attribute like (s_divisor = "<#>")
			Domain feedback<#>Enumeration<#>Accepted<#>Accepted with
					Restriction<#>Not Accepted<#>Clarification Needed<#>
					Change Responsible<#>Single<#>
			Text<#>Text<#>
	*/
	string s_ret = ""

	AttrDef ad = find(m, s_attr)
	//print ad.defval "\n"
	if (ad == null){
		return "Error:#1AttributeNotFound"
	}
	AttrType at = null
	AttrBaseType abt = null
	int enumSize, i = 0
	
	s_ret = "KEY:type" s_divisor ad.typeName s_divisor
	at = ad.type
	abt = at.type
	s_ret = s_ret "KEY:basetype" s_divisor stringOf(abt) s_divisor

	if ( abt == attrEnumeration){
		enumSize = at.size

		s_ret = s_ret "KEY:l_enum" s_divisor
		for (i=0; i< enumSize; i++){
			s_ret = s_ret at.strings[i] s_divisor
		}

		s_ret = s_ret "KEY:multi" s_divisor
		if (ad.multi){
			s_ret = s_ret "True" s_divisor
		}
		else{
			s_ret = s_ret "False" s_divisor	
		}
	}
	return s_ret
}

string getAbsnoByAttr(Module m, string s_attr, string s_to_search){
	Object o 
	string a
	for o in m do {
		a = o.s_attr
		if ( a == s_to_search){
			a = o."Absolute Number"
			return a
		}
	}
	return "False"
}

