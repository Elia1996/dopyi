string createLinks(Module m, int source_absno,
				   string s_m_target, int l_target_absno[],
				   string s_m_link){
	/* Create a link between two objects
	s_m_link = fullpath of the link module
	*/
	int i
	int max = sizeof l_target_absno - 1
	Object o_source = object(source_absno, m)
	if ( o_source == null ){
		return "Error:#1:Absolute number not found in source mod"
	}
	Module m_target = getModule(s_m_target, 0)
	if ( m_target == null ){
		return "Error #2: Target mod not found"
	}
	Module m_link = getModule(s_m_link, 1)
	if ( m_link == null ){
		return "Error #3: Link mod not found"
	}

	for i in 0:max do {
		Object o_target = object(l_target_absno[i], m_target)
		if ( o_target == null ){
			return "Error:#1:Absolute number not found in target mod"
		}
		o_source -> s_m_link -> o_target
	}
	current = m
	return "True"
}

string deleteLinks(Module m, int source_absno,
				   string s_m_target, int l_target_absno[],
				   string s_m_link){
	/* Delete a link between two objects
	s_m_link = fullpath of the link module
	*/
	int i
	int max = sizeof l_target_absno - 1
	current = m
	Object o_source = object(source_absno, m)
	if ( o_source == null ){
		return "Error:#1:Absolute number not found in source mod"
	}
	Module m_target = getModule(s_m_target, 0)
	if ( m_target == null ){
		return "Error #2: Target mod not found"
	}
	Link lref
	ModName_ srcModRef
	int absno = 0
	for lref in all o_source->s_m_link do { 
    	srcModRef = target lref
		if (matches(get_target(lref), s_m_target)){
			absno = targetAbsNo(lref)
			for i in 0:max do {
				if (absno == l_target_absno[i]){
					delete(lref)
					flushDeletions()
				}
			}
		}
	}
	return "True"
}

string deleteAllObjLinks(Module m, int absno){
	/* Delete all links from the specified object
	*/
	Object o = object(absno, m)
	if ( o == null ){
		return "Error:#1:Absolute number not found"
	}
	Link lref
	ModName_ srcModRef
	void ret
	for lref in all o->"" do {
		delete(lref)
	}
	flushDeletions()
	return "True"
}

