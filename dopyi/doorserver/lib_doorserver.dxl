string objCreateExtLink(Module m, int absno, string s_name, string s_descr,
						string s_url){
	/* Create an external link for the specified absno in module m
	*/
	// Object to use
	Object o = object(absno, m)
	if ( o == null ){
		return "Error:#1:Absolute number not found"
	}
	ExternalLink el = null
	// Create the link
	string ErrMess = create(o, s_descr, s_name, outward, openAsURL, s_url, el)
	if (null el)
		return "False"
	else
		return "True"
}

string objDeleteExtLink(Module m, int absno, string s_name){
	Object o = object(absno, m)
	if ( o == null ){
		return "Error:#1:Absolute number not found"
	}
	ExternalLink extlnk = null

	for extlnk in o->"" do {
		if (matches(name(extlnk), s_name)){
			delete(extlnk)
			return "True"
		}
	}
	flushDeletions()
	return "False"
}


string addLinkModuleDescriptor(string s_folder, string s_source,
							   string s_target, string s_linkmod, string descr){
	/* Add a link module descriptor
	addLinkModuleDescriptor("/xxx_SYS_TestsProject", "/xxx_SYS_TestsProject/TestDoorsmod",
							"/xxx_SYS_TestsProject/TestDoorsmod2",
							"/xxx_SYS_TestsProject/satisfy",
							"mod to satisfy")
	*/
	openModule(s_source, 1)
	current = folder s_folder
	Folder f = current Folder
	string ret = addLinkModuleDescriptor(f, s_source, s_target, false, true,
							             s_linkmod, descr)
	if ( ret == null )
		return "True"
	return "False"
}

