string makeBaseline(Module mm, bool increment_major,
					string s_suffix, string s_annotation, string s_div){
	/* Make a baseline of the module
	Args:
		m -> module to baseline
		increment_major -> increment the major version, if false increment
			the minor version
		suffix -> suffix to add to the baseline name
		annotation -> annotation to add to the baseline
	*/
	if ( mm == null ){
		return "Error #2: Target mod not found"
	}
	if ( increment_major ){
		create(nextMajor s_suffix, s_annotation)
	}
	else {
		create(nextMinor s_suffix, s_annotation)
	}
	Baseline b = getMostRecentBaseline(mm)
	int n_minor = minor(b)
	int n_major = major(b)
	s_suffix = suffix(b)

	return "KEY:major" s_div n_major s_div "KEY:minor" s_div n_minor s_div  "KEY:suffix" s_div s_suffix s_div
}



string defAttr(Module m, string s_attrname, string s_type, string s_default, string s_multi){
	/* Define an attribute
	Args:
		s_attrname -> name of the attribute
		s_type -> name of the type to use
		s_default -> default value of the attribute
		s_multi -> if "True" the attribute enable multi selection
	Return
		"True"/"False" -> false if the type doesn't exist
	*/
	current = m
	if ( ! exists attribute s_attrname ){
		AttrType at = find(m, s_type)
		// If the type doesn't exist
		if (null at){
			return "False"
		}
		if ( s_default == "" ){
			if ( s_multi == "True"){
				create type s_type multi true attribute s_attrname
			}
			else{
				create type s_type attribute s_attrname
	  		}
		}
		else{
			if ( s_multi == "True"){
				create type s_type (default s_default) multi true attribute s_attrname
			}
			else{
				create type s_type (default s_default) attribute s_attrname
	  		}
		}
	}
	return "True"
}

string typeExists(Module m, string s_type){
	/* Return True if the type exists.
	Args:
		s_type: name of the type
	Returns:
		string: True if the s_type exists. 
	*/
	current = m
	AttrType at = find(m, s_type)
	if (null at){
		return "False"
	}
	return "True"
}

string defEnumType(Module m, string s_type, string names[], int values[], int colors[]){
	/* Define an Enumeration Type:
	Args:
		m -> module open in edit mode in which add the type
		s_type -> name of the new type
		names[] -> list of enum defined like "string names[] = {"E1", "E2"}"
		values[] -> list of int values defined like "int values[] = {0, 1}"
		colors[] -> list of enum defined like "string names[] = {14, 24, 20}"
	Return:
		"True"/"False"
	*/
	AttrType at = find(m, s_type)
	// If the type doesn't exist
	if (null at){
	    string mess = ""
	    AttrType at = create(s_type, names, values, colors, mess)
	    if (!null mess)
	        return "False"
	}
	return "True"
}

string defType(Module m, string s_type, string s_basetype){
	/*Define a type, s_basetype can't be enumeration

	Args:
		m: module open in edit mode in which add the type
		s_type : name of the new type
		s_basetype: "String", "Text", "Integer", "Date",
            "Username" or "Real"
	*/
	AttrType at = find(m, s_type)
	// If the type doesn't exist
	if (null at){
	    string mess = ""
		if (s_basetype == "String")
	    	at = create(s_type, attrString, mess)
		if (s_basetype == "Text")
	    	at = create(s_type, attrText, mess)
		if (s_basetype == "Integer")
	    	at = create(s_type, attrInteger, mess)
		if (s_basetype == "Date")
	    	at = create(s_type, attrDate, mess)
		if (s_basetype == "Username")
	    	at = create(s_type, attrUsername, mess)
		if (s_basetype == "Real")
	    	at = create(s_type, attrReal, mess)
	    if (!null mess)
	        return "False"
	}
	return "True"
}

string delType(Module m, string s_type){
	/* Delete a type
	Args:
		s_type -> Name of the type
	Return:
		"True"/"False"
	*/
	AttrType at = find(m, s_type)
	string s
	if (!null at){
  	  	delete(at, s)
  	  	return "True"
  	}
  	return "False"
}

string setAttributes(Module m, int absno, string l_attr[], string l_val[], string l_mode[]){
	/* Modify the value of a set of attr
	Args:
		m -> module open in edit mode
		absno -> absno to modify
		l_attr -> list of attribute names
		l_val -> list of value
		l_mode -> list of modes, "apnd" to append the value for text, "add"
			to ad a selection in enum multi value, "repl" or "" to replace the value
			"pre" to add the text above the current text
	Return:
		"True"/"False"
	*/
	int i
	int max = sizeof l_attr - 1

	string supp
	Object o = object(absno, m)

	for i in 0:max do{
		if (l_mode[i] == "apnd"){
			o.l_attr[i] = o.l_attr[i] l_val[i]
		}
		else if (l_mode[i] == "add"){
			o.l_attr[i] += l_val[i]
		}
		else if (l_mode[i] == "repl" || l_mode[i] == ""){
			supp = o.l_attr[i]
			if (supp != l_val[i])
				o.l_attr[i] = l_val[i]
		}
		else if (l_mode[i] == "pre"){
			o.l_attr[i] = l_val[i] o.l_attr[i] ""
		}
		else{
			return "False"
		}
	} 
	return "True"
}



//---------------------------------------------------------------------------------------------------------------------------------------------------------------
// View functions
//---------------------------------------------------------------------------------------------------------------------------------------------------------------

string defView(Module m, string s_viewname, string l_attr[], bool set_default){
	/* Automatically set the attribute inside a view in the given order.
	Args:
	 	m -> Module in read/edit mode
	 	s_viewname -> The name of the new view
	 	l_attr[] -> The list of attribute to add
	*/
	int i
	int max = sizeof l_attr - 1
	int n_col = 0
	AttrDef ad
	Column c
	int n = 0

	//// Delete current attribute from view
	// number of existing columns
	for c in current Module do n++
	// delete all columns
	for i in 1:n do
	    delete(column 0)

	insert(column 0);
	attribute(column 0, "Object Identifier");
	width(column 0, 80);
   	justify(column 0, left);

	// Add the main Column (Object Heading+
    // Object Text) to the View
    Column mainColumn = null;
    mainColumn = insert mainColumn;
    main mainColumn;
    width(mainColumn, 300);

	// add each column in correct order
	for i in 0:max do {		
		ad = find(m, l_attr[i])
		if (null ad){
			return "False"
		}
		n_col = i + 2;
		insert(column n_col)
		attribute(column n_col, ad.name )
		len = length(ad.name)*5+5
		width(column n_col, len)
		justify(column n_col, center)
	}

	refresh current
	save view s_viewname
	if (set_default){
		setDefaultViewForModule(m, s_viewname)
	}
	return "True"
}

//-----------------------------------------------------------------------------
// Global function
//-----------------------------------------------------------------------------

string scanModulesInFolder(string s_folder, int n_level, string s_divisor){
	/* Retun all module in a folder, the number of folder
	level to analye is n_level
			n_level >= 1 iterate 1 or more level
			n_leve = 0 get module of current dir, no recursion 
			n_level = -1 -> explore all levels
	*/
	Item itm
	current = folder s_folder
	Folder f = current Folder 	 	 
		
	if (null f)
	{
		return ""
	}

	int n_new_level = n_level - 1
	string msg = ""
	// loop through items at top level of folder
	for itm in f do
	{
		//print type(itm) " " fullName(itm) "\n"
		// sensible checks to avoid run-time errors
		if (null itm) continue
		if (isDeleted(itm)) continue
		
		else if (type (itm) == "Formal"){
			// do something with formal module
			msg = msg fullName(itm) s_divisor
		}
		else  if (type(itm) == "Folder" or type(itm) == "Project"){
			if (n_level > 0){
				msg = msg scanModulesInFolder(fullName(itm), n_new_level, s_divisor)
			}
			else{
				if (n_level == -1){
					msg = msg scanModulesInFolder(fullName(itm), n_new_level, s_divisor)
				}
			}
		}
		
	}
	return msg
}

string getLinkSet(string s_folder, string s_div)
{
	current = folder s_folder
	Project p = current
	Item itemref
	LinkModuleDescriptor linkmoddesc
	string s = ""
	string sto = ""
	string slink = ""
	string sret = ""
	
	for itemref in p do {                      
		if(type(itemref)!= "Folder") then continue
		
		for linkmoddesc in folder itemref do {             
			sto=  getTargetName(linkmoddesc )
			s = getSourceName(linkmoddesc)
			slink = getName(linkmoddesc)
			//store s in skip list...
			sret = sret s s_div sto s_div slink s_div
		}// end of link module descriptor in folder loop
	
	} // end of folder in project loop
	return sret
}

string scanFoldersInFolder(string s_folder)
{
	/*

	*/
	Item itm
	current = folder s_folder
	Folder f = current Folder 	 	 
		
	if (null f)
	{
		return ""
	}

	string msg = ""
	int max = 0, i=0
	// loop through items at top level of folder
	for itm in f do {
		if (type(itm) == "Folder" or type(itm) == "Project"){
			max  = max  + 1 
		}
	}
	for itm in f do
	{
		if (null itm) continue
		if (isDeleted(itm)) continue
		
		if (type(itm) == "Folder" or type(itm) == "Project"){
			msg = msg "\"" fullName(itm) "\""
			string ret = scanFoldersInFolder(fullName(itm))
			i = i + 1
			if ( ret == "{}" ){
				if ( i == max )
					msg = msg ":{}"
				else
					msg = msg ":{} ,"

			}
			else{
				if ( i == max )
					msg = msg ":" ret
				else
					msg = msg ":" ret ","
			}
		}
		
	}
	return "{" msg "}"
}

string getAbsnoList(Module m){
	Object o
	string msg = ""
	for o in m do {
		if (msg != "")
			msg = msg ", " o."Absolute Number" ""
		else
			msg = o."Absolute Number" ""
	}
	return "[" msg "]"
}