bool isModOpened(string s_mod){
	/* Return true if the module is already opened
	*/
	Module m
	for m in database do {
		if (matches(s_mod,fullName(m))){
			return true
		}
	}
	return false
}

string get_modname(string mod){
	Skip ll = split(mod, '@')
	string value;
	if(find(ll, 0, value)){
		return value
	}
	return ""
}

string get_baselineid(string mod){
	Skip ll = split(mod, '@')
	string value;
	if(find(ll, 1, value)){
		return value
	}
	return ""
}

string get_suffix(string baselineid){
	Skip ll = split(baselineid, '_')
	string value;
	if (count(ll) < 2){
		return ""
	}

	if(find(ll, 0, value)){
		return value
	}
	return ""
}

int get_major(string baselineid){
	Skip ll = split(baselineid, '_')
	string value;
	int el = count(ll)-1

	if(find(ll, el, value)){
		Skip ll2 = split(value, '.')
		if(find(ll2, 0, value)){
			return intOf(value)
		}
	}
	return 0
}

int get_minor(string baselineid){
	Skip ll = split(baselineid, '_')
	string value;
	int el = count(ll)-1

	if(find(ll, el, value)){
		Skip ll2 = split(value, '.')
		if(find(ll2, 1, value)){
			return intOf(value)
		}
	}
	return 0
}


Module getModule(string s_mod, int mode){
	/* l_mods: skip of modules
	 s_mod: module complete path
	 mode: 1 -> write, 0 -> Read
	*/
	bool bl_open = false
	s_mod_and_baseline = s_mod
	s_mod = get_modname(s_mod_and_baseline)
	string s_bsline = get_baselineid(s_mod_and_baseline)
	string s_suffix = ""
	int s_major = 0
	int s_minor = 0
	if ( s_bsline != "" ){
		s_suffix = get_suffix(s_bsline)
		s_major = get_major(s_bsline)
		s_minor = get_minor(s_bsline)
	}
	Module m = null
	if ( ! exists module s_mod )
	    return m

	Baseline bsline = null

	if ( s_bsline != "" ){
		if (mode == 1){
			return m
		}
	}
	// If the module is opened
	if (open module s_mod){
		Item i_mod = item s_mod
		m = module(i_mod)
		if ( mode == 1 ){
			// write mode
			if (! isEdit(m)) m = edit(s_mod, bl_open)
		}
		else{
			// read mode
			if (! isRead(m)) m = read(s_mod, bl_open)
		}
	}
	else{
		if ( mode == 1 ){
			// write mode
			m = edit(s_mod, bl_open)
		}
		else{
			// read mode
			m = read(s_mod, bl_open)
		}
	}

	if ( null(m) ){ 
	    return m
	}
	else{
	    if ( mode == 1 ){
			// write mode
			if ( !canWrite(m) ) return m
		}
		else{
			// read mode
			if ( !canRead(m) ) return m
		}
	}
	print "s_bsline: " s_bsline "\n"
	if ( s_bsline != "" ){
		print "openin baseline " s_bsline "\n"
		bsline = baseline(s_major, s_minor, s_suffix)
		bs_mod = load(m, bsline, bl_open)
		m = bs_mod
	}
	filtering off
	return m
}

string openModule(string s_mod, int mode){
	/* l_mods: skip of modules
	 s_mod: module complete path
	 mode: 1 -> write, 0 -> Read
	*/
	bool bl_open = false
	s_mod_and_baseline = s_mod
	s_mod = get_modname(s_mod_and_baseline)
	string s_bsline = get_baselineid(s_mod_and_baseline)
	string s_suffix = ""
	int s_major = 0
	int s_minor = 0
	if ( s_bsline != "" ){
		s_suffix = get_suffix(s_bsline)
		s_major = get_major(s_bsline)
		s_minor = get_minor(s_bsline)
	}
	if ( ! exists module s_mod )
	    return "Error:#1:Module " s_mod " doesn't exist."

	Baseline bsline = null

	if ( s_bsline != "" ){
		if (mode == 1){
			return "Error:#2:Module " s_mod " is a baseline, cannot be opened in write mode."
		}
	}
	Module m = null
	// If the module is opened
	if (open module s_mod){
		Item i_mod = item s_mod
		m = module(i_mod)
		if ( mode == 1 ){
			// write mode
			if (! isEdit(m)) m = edit(s_mod, bl_open)
		}
		else{
			// read mode
			if (! isRead(m)) m = read(s_mod, bl_open)
		}
	}
	else{
		if ( mode == 1 ){
			// write mode
			m = edit(s_mod, bl_open)
		}
		else{
			// read mode
			m = read(s_mod, bl_open)
		}
	}

	if ( null(m) ){ 
	    return "Error:#3:Null"
	}
	else{
	    if ( mode == 1 ){
			// write mode
			if ( !canWrite(m) ) return "Error:#4:CantWrite"
		}
		else{
			// read mode
			if ( !canRead(m) ) return "Error:#5:CantRead"
		}
	}
	if ( s_bsline != "" ){
		bsline = baseline(s_major, s_minor, s_suffix)
		bs_mod = load(m, bsline, bl_open)
		current = bs_mod
	}
	else {
		current = m
	}
	filtering off
	return "Opened"
}

string closeModule(string s_mod){
	/* Close the specified module inside l_mods using the key n_mod
	*/
	s_mod = get_modname(s_mod)
	string s_bsline = get_baselineid(s_mod)
	string s_suffix = ""
	int s_major = 0
	int s_minor = 0
	if ( s_bsline != "" ){
		s_suffix = get_suffix(s_bsline)
		s_major = get_major(s_bsline)
		s_minor = get_minor(s_bsline)
	}

	Item i_mod = item s_mod
	Module m = module(i_mod)
	if( m == null ){
		return "Error:#1:Module " s_mod " doesn't exist."
	}

	if ( s_bsline != "" ){
		Baseline bsline = baseline(s_major, s_minor, s_suffix)
		m = load(m, bsline, false)
	}

	close(m)
	return "Deleted"

}

string saveModule(string s_mod){
	/* This function save a module if it is in edit mode
	*/
	s_mod = get_modname(s_mod)
	string s_bsline = get_baselineid(s_mod)
	string s_suffix = ""
	int s_major = 0
	int s_minor = 0
	if ( s_bsline != "" ){
		s_suffix = get_suffix(s_bsline)
		s_major = get_major(s_bsline)
		s_minor = get_minor(s_bsline)
	}

	if ( s_bsline != "" ){
		return "Error:#2:Module " s_mod " is a baseline, cannot be saved."
	}

	Item i_mod = item s_mod
	Module m = module(i_mod)

	if( m == null ){
		return "Error:#1:Module number " s_mod " doesn't exist."
	}

	if ( isRead m ) return "Error:#2:Module " s_mod " in read mode."
	if ( isEdit m ){
		save(m)
		return "Saved"
	}
	return "Error:#3:Not Open Module " s_mod 
}

