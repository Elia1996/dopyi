string getBaselines(Module m, string s_div){
	/*Get the list of the baselines in the module
	Args:
		m -> module open in read mode
		s_div -> list divider
	Return:
		string: <major> <divider> <minor> <divider> <suffix> <divider>
	*/
	Baseline bsline
	string s_ret = ""
	for bsline in m do {
		s_ret = s_ret (major bsline) s_div
		s_ret = s_ret (minor bsline) s_div
		s_ret = s_ret (suffix bsline) s_div
		s_ret = s_ret (annotation bsline) s_div
		s_ret = s_ret (dateOf bsline) s_div
		s_ret = s_ret (user bsline) s_div
	}
	return s_ret
}


string getAttributes(Module m, int absno, string l_attr[], string s_div){
	/* Modify the value of a set of attr
	Args:
		m -> module open in edit mode
		absno -> absno to modify
		l_attr -> list of attribute names
		div : list divider for returning string
	Return:
		list: l_attr values
	*/
	int i
	string supp
	int max = sizeof l_attr - 1

	string s_ret = ""
	Object o = object(absno, m)

	for i in 0:max do{
		// check for special attributes
		if (l_attr[i] == "Object Level"){
			supp = level(o) ""
			s_ret = s_ret supp s_div
		}
		else{	
			s_ret = s_ret o.l_attr[i] "" s_div
		}
	} 
	return s_ret
}


